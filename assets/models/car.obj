# Mercedes 200 Classic - OBJ
# Espacio: x,y,z en [-1,1]

# ──── VÉRTICES ────

# CARROCERÍA PRINCIPAL (1-16)
# Base inferior
v -0.55 -0.15 0.95   # 1  frontal izq bajo
v  0.55 -0.15 0.95   # 2  frontal der bajo
v -0.55 -0.15 -0.95  # 3  trasera izq bajo
v  0.55 -0.15 -0.95  # 4  trasera der bajo

# Cuerpo lateral (línea de cintura baja)
v -0.58 0.02 0.90    # 5  frontal izq med
v  0.58 0.02 0.90    # 6  frontal der med
v -0.58 0.02 -0.88   # 7  trasera izq med
v  0.58 0.02 -0.88   # 8  trasera der med

# Cuerpo lateral alto
v -0.56 0.28 0.80    # 9  frontal izq alto
v  0.56 0.28 0.80    # 10 frontal der alto
v -0.56 0.28 -0.78   # 11 trasera izq alto
v  0.56 0.28 -0.78   # 12 trasera der alto

# CAPÓ (13-20)
v -0.52 0.28 0.80    # 13 unión capó-cabina izq
v  0.52 0.28 0.80    # 14 unión capó-cabina der
v -0.50 0.30 0.40    # 15 capó izq trasero
v  0.50 0.30 0.40    # 16 capó der trasero
v -0.42 0.32 0.95    # 17 morro izq
v  0.42 0.32 0.95    # 18 morro der
v -0.42 0.10 0.98    # 19 paragolpes frontal izq
v  0.42 0.10 0.98    # 20 paragolpes frontal der

# CABINA (21-32)
