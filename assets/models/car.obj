v  0.50 0.30 0.40    # 22 = ~16, pilar A der
v -0.52 0.62 0.32    # 23 techo frontal izq
v  0.52 0.62 0.32    # 24 techo frontal der
v -0.52 0.64 -0.32   # 25 techo trasero izq
v  0.52 0.64 -0.32   # 26 techo trasero der
v -0.50 0.30 -0.38   # 27 pilar C izq
v  0.50 0.30 -0.38   # 28 pilar C der
v -0.52 0.28 -0.40   # 29 unión cabina-maletero izq
v  0.52 0.28 -0.40   # 30 unión cabina-maletero der

# MALETERO (31-38)
