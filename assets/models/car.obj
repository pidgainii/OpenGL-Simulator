v  0.50 0.32 -0.40   # 32 ~ 30
v -0.48 0.30 -0.88   # 33 maletero izq trasero
v  0.48 0.30 -0.88   # 34 maletero der trasero
v -0.44 0.10 -0.98   # 35 paragolpes trasero izq
v  0.44 0.10 -0.98   # 36 paragolpes trasero der

# PARABRISAS (37-40)
