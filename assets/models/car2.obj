# Mercedes 200 Classic Sedan - OBJ
# Espacio: x,y,z en [-1,1]
# Proporciones ajustadas para estilo sedán clásico (W123/W124)

# ──── VÉRTICES ────

# CARROCERÍA PRINCIPAL (1-16)
# Base inferior
v -0.38 -0.12 0.90   # 1  frontal izq bajo
v  0.38 -0.12 0.90   # 2  frontal der bajo
v -0.38 -0.12 -0.90  # 3  trasera izq bajo
v  0.38 -0.12 -0.90  # 4  trasera der bajo

# Cuerpo lateral (línea de cintura baja - pliegue de puerta)
v -0.40 0.08 0.92    # 5  frontal izq med
v  0.40 0.08 0.92    # 6  frontal der med
v -0.40 0.08 -0.92   # 7  trasera izq med
v  0.40 0.08 -0.92   # 8  trasera der med

# Cuerpo lateral alto (base de las ventanillas)
v -0.38 0.22 0.88    # 9  frontal izq alto
v  0.38 0.22 0.88    # 10 frontal der alto
v -0.38 0.22 -0.88   # 11 trasera izq alto
v  0.38 0.22 -0.88   # 12 trasera der alto

# CAPÓ (13-20)
v -0.36 0.22 0.35    # 13 unión capó-cabina izq
v  0.36 0.22 0.35    # 14 unión capó-cabina der
v -0.36 0.22 0.35    # 15 capó izq trasero
v  0.36 0.22 0.35    # 16 capó der trasero
v -0.25 0.18 0.93    # 17 morro izq (Parrilla estrecha Mercedes)
v  0.25 0.18 0.93    # 18 morro der
v -0.35 0.00 0.95    # 19 paragolpes frontal izq
v  0.35 0.00 0.95    # 20 paragolpes frontal der

# CABINA (21-32)
v -0.36 0.22 0.35    # 21 = pilar A izq
v  0.36 0.22 0.35    # 22 = pilar A der
v -0.28 0.42 0.15    # 23 techo frontal izq
v  0.28 0.42 0.15    # 24 techo frontal der
v -0.28 0.42 -0.30   # 25 techo trasero izq
v  0.28 0.42 -0.30   # 26 techo trasero der
v -0.36 0.22 -0.50   # 27 pilar C izq
v  0.36 0.22 -0.50   # 28 pilar C der
v -0.36 0.22 -0.50   # 29 unión cabina-maletero izq
v  0.36 0.22 -0.50   # 30 unión cabina-maletero der

# MALETERO (31-38)
v -0.36 0.22 -0.50   # 31 ~ 29
v  0.36 0.22 -0.50   # 32 ~ 30
v -0.34 0.20 -0.92   # 33 maletero izq trasero (Plano)
v  0.34 0.20 -0.92   # 34 maletero der trasero
v -0.35 0.00 -0.95   # 35 paragolpes trasero izq
v  0.35 0.00 -0.95   # 36 paragolpes trasero der

# PARABRISAS (37-40)
v -0.36 0.22 0.35    # 37 = pilar A izq
v  0.36 0.22 0.35    # 38 = pilar A der
v -0.28 0.42 0.15    # 39 = techo frontal izq
v  0.28 0.42 0.15    # 40 = techo frontal der

# LUNETA TRASERA (41-44)
v -0.36 0.22 -0.50   # 41 = pilar C izq
v  0.36 0.22 -0.50   # 42 = pilar C der
v -0.28 0.42 -0.30   # 43 = techo trasero izq
v  0.28 0.42 -0.30   # 44 = techo trasero der

